<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/php/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Reatcarto">
            <directory>tests/php</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="DB_HOST" value="localhost"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_NAME" value="reatcarto_test"/>
        <env name="DB_USER" value="postgres"/>
        <env name="TERMS_VERSION" value="1.0.0"/>
        <env name="PRIVACY_VERSION" value="1.0.0"/>
        <env name="ADMIN_EMAIL" value="admin@test.example"/>
        <env name="ADMIN_USERNAME" value="testadmin"/>
        <env name="ADMIN_PASSWORD" value="TestAdmin123!"/>
    </php>
</phpunit>

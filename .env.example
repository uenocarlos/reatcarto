# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=reatcarto
DB_USER=postgres
DB_PASSWORD=

# SMTP (Mailpit/Mailhog in dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@example.com

# Legal document versions (bodies are external)
TERMS_VERSION=1.0.0
PRIVACY_VERSION=1.0.0

# Writable photo uploads root (relative to project root or absolute path)
UPLOADS_ROOT=uploads

# PHP session cookie flags
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax
SESSION_NAME=REATCARTO_SESSID

# First admin bootstrap (used only when no admin exists)
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
